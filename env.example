# Copy this file to .env for local development:
#   cp .env.example .env
# Then fill in the values from your Supabase project settings
# (Project Settings -> API). Never commit the real .env file.
#
# On Netlify, set these under Site settings -> Environment variables instead
# of committing a .env file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
